# Environment setup for Research Copilot

APP_NAME=Research Copilot
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database setup
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=copilot

# URLs constructed automatically in docker-compose.yml
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/copilot
# REDIS_URL=redis://redis:6379/0

# Security (Change this in production to at least 32 characters!)
JWT_SECRET_KEY=super-secret-key-for-development-only-do-not-use-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Uploads
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_PAGES=500
UPLOAD_DIR=/data/uploads

# Providers (Use mock for local deterministic offline testing)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

LLM_PROVIDER=mock
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Rate limits
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=5

WORKER_ENABLED=true
METRICS_ENABLED=true
SEED_ON_STARTUP=false
